# Feedback-round secrets for the shared gallery. `via env init` (run by the justfile) turns these
# macros into values in .env, which is gitignored. Nothing secret is ever written in this file.
#
#   REVIEW_USER      basic-auth user every reviewer shares
#   REVIEW_PASSWORD  basic-auth password (random, rotated when a new round opens)
#   REVIEW_SLUG      random part of the public host (icons-<slug>.<relay domain>) and of the
#                    path every shared link must start with (/r/<slug>/...); rotated with the password
REVIEW_USER=reviewer
REVIEW_PASSWORD=${{ macro.getRandomString(length=24, charset="alnum") }}
REVIEW_SLUG=${{ macro.getRandomString(length=12, charset="hex") }}
